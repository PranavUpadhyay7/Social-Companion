# Keep real values in the hosting provider's secret manager. Never commit them.
MONGODB_URI=mongodb://127.0.0.1:27017/scenemates
AUTH_SECRET=replace-with-a-random-value-of-at-least-32-bytes
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Set this only when the production proxy/host is controlled by you.
AUTH_TRUST_HOST=false
TRUST_PROXY_HEADERS=false
